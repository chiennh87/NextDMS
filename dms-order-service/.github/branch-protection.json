# Branch Protection Rules Configuration
# Apply these settings in GitHub > Settings > Branches > Branch protection rules

# ============================================
# PROTECTION RULES FOR MAIN BRANCH
# ============================================

{
  "branch_name_pattern": "main",
  "settings": {
    "enforce_admins": true,
    "required_status_checks": {
      "strict": true,
      "checks": [
        {
          "context": "Lint Code",
          "app_id": null
        },
        {
          "context": "Run Tests",
          "app_id": null
        }
      ]
    },
    "enforce_linear_history": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "required_approving_review_count": 2
    },
    "restrictions": null,
    "allow_force_pushes": false,
    "allow_deletions": false
  }
}

# ============================================
# PROTECTION RULES FOR DEVELOP BRANCH
# ============================================

{
  "branch_name_pattern": "develop",
  "settings": {
    "enforce_admins": true,
    "required_status_checks": {
      "strict": true,
      "checks": [
        {
          "context": "Run Tests",
          "app_id": null
        }
      ]
    },
    "enforce_linear_history": false,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": false,
      "required_approving_review_count": 1
    },
    "restrictions": null,
    "allow_force_pushes": true,
    "allow_deletions": false
  }
}
